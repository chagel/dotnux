// One bar per monitor, each showing only the workspaces pinned to it.
//
// Hyprland pins workspaces 1-5 to the left panel and 6-9 to the right (see the
// workspace rules in configs/hypr/hyprland.lua) -- these bars mirror that split.
// This used to be a single bar object with all nine ws modules and no "output"
// key, which made waybar draw the identical bar on every monitor, so all nine
// indicators appeared on both screens.
//
// "output" matches the monitor description, not DP-N, because the dock
// renumbers its ports between reconnects. It must be the description verbatim
// as `hyprctl monitors` prints it: waybar compares the whole string and
// supports neither "*" wildcards nor Hyprland's "desc:" prefix -- either one
// silently matches nothing and the bar just never appears.
// Module definitions are shared via "include".
//
// Only the left bar carries the status modules -- duplicate clocks, battery and
// network readouts on both screens add noise without information. The right bar
// keeps a clock so it is not bare.
[
	{
		"name": "left",
		"output": [
			"Dell Inc. DELL P2715Q 54KKD7AA486L",
			"eDP-1"
		],
		"include": [
			"~/.config/waybar/modules.jsonc"
		],
		"position": "top",
		"margin": "5 10 0 0",
		"mod": "dock",
		"modules-left": [
			"custom/ws1",
			"custom/ws2",
			"custom/ws3",
			"custom/ws4",
			"custom/ws5"
		],
		"modules-center": [
			"hyprland/window"
		],
		"modules-right": [
			"network",
			"bluetooth",
			"battery",
			"pulseaudio",
			"clock#shanghai",
			"custom/clock"
		]
	},
	{
		"name": "right",
		"output": [
			"Dell Inc. DELL U2718Q 4K8X78A61P3L"
		],
		"include": [
			"~/.config/waybar/modules.jsonc"
		],
		"position": "top",
		"margin": "5 10 0 0",
		"mod": "dock",
		"modules-left": [
			"custom/ws6",
			"custom/ws7",
			"custom/ws8",
			"custom/ws9"
		],
		"modules-center": [
			"hyprland/window"
		],
		"modules-right": [
			"custom/clock#date"
		]
	}
]
