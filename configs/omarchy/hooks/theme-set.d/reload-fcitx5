#!/bin/bash
# Reload fcitx5 after a theme switch.
#
# The theme file itself is regenerated by the fcitx5.conf.tpl template, but
# fcitx5 parses theme.conf once and caches it, so the new colors only reach
# the candidate popup after a config reload. Quiet no-op when fcitx5 is not
# running, so a theme switch from a tty or before autostart still succeeds.

pgrep -x fcitx5 >/dev/null || exit 0
fcitx5-remote -r 2>/dev/null || true
