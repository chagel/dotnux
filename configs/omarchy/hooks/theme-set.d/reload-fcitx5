#!/bin/bash
# Apply a new theme to the fcitx5 candidate popup.
#
# fcitx5.conf.tpl regenerates the theme on every switch, but `fcitx5-remote -r`
# rereads the addon configs only -- it never opens theme.conf, so the popup
# keeps whatever colours it parsed at startup. Verified with inotifywait: a
# reload produces no read event on the file, a restart produces an OPEN. The
# theme name never changes either (always "omarchy"), so there is nothing for
# fcitx5 to notice, and fcitx5-remote has no theme-reload of its own.
#
# Restarting costs the active input-method selection, which is cheap on a theme
# switch. Quiet no-op when fcitx5 is not running, so switching from a tty or
# before autostart still succeeds.

pgrep -x fcitx5 > /dev/null || exit 0

if systemctl --user is-active --quiet omarchy-fcitx5.service; then
  systemctl --user restart omarchy-fcitx5.service
else
  # Running outside its unit, so there is nothing to restart it afterwards.
  # Reload instead: it will not repaint the popup, but it beats leaving the
  # session with no input method at all.
  fcitx5-remote -r 2> /dev/null || true
fi
