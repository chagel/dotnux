#!/bin/bash
# Check after `omarchy update` that nothing we link became a file Omarchy
# rewrites, while the update is still the obvious cause.
#
# Advisory only: it never blocks the update, and it notifies because a
# post-update hook's stdout scrolls past unread.

set -uo pipefail

AUDIT="$HOME/Dotfiles/scripts/omarchy-audit"
[[ -x $AUDIT ]] || exit 0

output=$("$AUDIT" 2>&1)
status=$?

echo "$output"

if ((status != 0)); then
  summary=$(grep -c '^  ERROR' <<< "$output" || true)
  omarchy-notification-send -u critical \
    "Dotnux: $summary customization error(s) after update" \
    "Run 'make audit' in ~/Dotfiles for details." 2>/dev/null || true
fi

exit 0
