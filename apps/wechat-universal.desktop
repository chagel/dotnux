[Desktop Entry]
Comment=WeChat Universal
Comment[zh_CN]=
TryExec=/usr/lib/wechat-universal/start.sh
# WECHAT_IME_WORKAROUND: start.sh only exports QT_IM_MODULE/GTK_IM_MODULE when
# it can see @im=fcitx in XMODIFIERS, and omarchy sets XMODIFIERS in
# environment.d -- which only reaches apps in a uwsm-managed session. Naming
# the workaround outright is what start.sh's own `auto` detection would have
# picked, and it holds however the session was started.
Exec=env WECHAT_IME_WORKAROUND=fcitx QT_SCALE_FACTOR=1.25 /usr/lib/wechat-universal/start.sh %u
Icon=wechat-universal
Name=WeChat (Universal)
Name[zh_CN]=微信 Universal
Categories=Network;InstantMessaging;Chat;
Terminal=false
Type=Application
Keywords=wechat;weixin;we;w;
Keywords[zh_CN]=微;微信;wechat;weixin;we;
StartupWMClass=wechat
X-GNOME-SingleWindow=true
SingleMainWindow=true
Actions=quit;

[Desktop Action quit]
Name=Quit WeChat
Name[zh_CN]=退出
Exec=/usr/lib/wechat-universal/stop.sh
Icon=application-exit
