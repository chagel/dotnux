#!/bin/sh

# Herdr side of vim-aware pane navigation, mirroring what the
# vim-tmux-navigator plugin binds in tmux: ctrl+hjkl moves between herdr panes,
# except when the focused pane is running vim, where the key is handed to vim so
# it can move between splits instead. Without this herdr swallows ctrl+hjkl and
# vim never sees it, so window-local moves (the tree view, a diff split) are
# unreachable.
#
# tmux decides with `ps -t #{pane_tty}`; herdr exposes the same thing over its
# socket API as `pane process-info`. Only the process leading the foreground
# group counts -- the list also carries children (an LSP, an MCP server), and
# matching those would misfire.
#
# vim itself hands control back at the edge of its window layout by calling
# `herdr pane focus` -- see dotbase/nvim/lua/plugins/tmux.lua.
#
# usage: herdr-navigate <left|down|up|right> <key-to-forward>

set -eu

dir=$1
key=$2

# Resolve the pane the key was pressed in. `--current` is deliberately not used:
# it reads the calling pane out of the environment, which is a property of the
# shell a command was launched from rather than of the keypress, so it points at
# the wrong pane whenever the focused workspace is not the one that shell lives
# in. herdr exports the active pane to keybinding commands; the layout's
# focused pane is the same answer by another route if it ever does not.
pane=${HERDR_ACTIVE_PANE_ID:-}
[ -n "$pane" ] || pane=$(herdr pane layout 2>/dev/null | jq -r '.result.layout.focused_pane_id // ""')

focus() {
  herdr pane focus --pane "$pane" --direction "$dir" >/dev/null 2>&1 || true
  exit 0
}

[ -n "$pane" ] || exit 0
info=$(herdr pane process-info --pane "$pane" 2>/dev/null) || focus

# The alternation matches tmux's is_vim check: vi/vim/view/nvim and the l/g/x
# spellings, plus fzf, which also wants the raw keys.
name=$(printf '%s' "$info" | jq -r '
  .result.process_info as $i
  | [ $i.foreground_processes[]?
      | select(.pid == $i.foreground_process_group_id)
      | .name ][0] // ""
' 2>/dev/null) || focus

printf '%s' "$name" | grep -qE '^(g?(view|l?n?vim?x?)|fzf)$' || focus

herdr pane send-keys "$pane" "$key" >/dev/null 2>&1 || true
