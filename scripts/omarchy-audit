#!/usr/bin/env python3
"""Check the one rule that breaks silently: never link a file Omarchy rewrites.

Omarchy edits a handful of configs in place. `sed -i` renames its temp file over
the target and omarchy-shell-config `mv`s over a literal path -- neither follows
a link, so a link becomes a regular file and the config leaves git without a
word. Everything else in docs/omarchy.md you notice immediately when it breaks;
this you do not.

The list is derived from the installed omarchy-* scripts rather than hardcoded,
so a new one shows up on its own after an update.

Runs from configs/omarchy/hooks/post-update.d after every `omarchy update`.
"""

import re
import sys
from pathlib import Path

HOME = Path.home()

# What the derivation found last time this was checked, so a change is visible.
KNOWN = {
    ".config/alacritty/alacritty.toml",
    ".config/foot/foot.ini",
    ".config/ghostty/config",
    ".config/kitty/kitty.conf",
    ".config/omarchy/shell.json",
}

# A trailing slash means the write lands a file inside a directory rather than
# replacing a config, so those are skipped.
SED_IN_PLACE = re.compile(r"sed[^\n|]*?-i[^\n]*?(?:\$HOME|\$\{HOME\}|~)(/\.config/[\w./-]+)")

# omarchy-shell-config names its target in a variable and mv's onto that, so the
# path never appears on the mv line. Naming a file in CONFIG_FILE is not enough
# on its own -- the refresh scripts do that too, and they delegate to a copy that
# writes *through* a link rather than replacing it.
CONFIG_FILE_VAR = re.compile(r'CONFIG_FILE="\$(?:HOME|\{HOME\})(/\.config/[\w./-]+)"')
MV_ONTO_VAR = re.compile(r'mv\s+[^\n]*"\$\{?\w*CONFIG_FILE')


def derive():
    found = set()
    for script in sorted(Path("/usr/bin").glob("omarchy-*")):
        try:
            text = script.read_text(errors="ignore")
        except OSError:
            continue
        matches = list(SED_IN_PLACE.finditer(text))
        if MV_ONTO_VAR.search(text):
            matches += CONFIG_FILE_VAR.finditer(text)
        for match in matches:
            target = match.group(1)
            if not target.endswith("/"):
                found.add(target.lstrip("/"))
    return found


def main():
    derived = derive()
    errors = 0

    if not derived:
        print("warn  no in-place writers found -- the detection pattern may be stale")
    for extra in sorted(derived - KNOWN):
        print(f"warn  Omarchy now rewrites {extra} too -- add it to KNOWN")

    for rel in sorted(KNOWN | derived):
        path = HOME / rel
        if not path.exists():
            continue
        if path.is_symlink():
            print(f"ERROR {rel} is a link; Omarchy will replace it and unlink the repo copy")
            errors += 1
        else:
            print(f"ok    {rel}")

    if errors:
        print(f"\n{errors} error(s) -- see docs/omarchy.md")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
