#!/bin/sh
#
# Live dictionary. Opens a terminal running fzf; the entry re-renders as you
# type, and selecting a line copies it.
#
# A terminal rather than fuzzel for two reasons: fuzzel 1.14 has no IME support
# (text-input-v3 landed after it, still unreleased), so Chinese cannot be typed
# into it at all, and it cannot re-run a query per keystroke. Both work here.
#
#   define            open the terminal UI
#   define --tui      the fzf loop itself, run inside that terminal
#   define --lookup W print one entry, used by fzf on every keystroke

set -eu

SELF=$(readlink -f "$0")
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/define"
TERMINAL=${TERMINAL:-ghostty}

notify() {
  command -v notify-send > /dev/null 2>&1 && notify-send -u critical define "$1"
  echo "define: $1" >&2
}

lookup() {
  word=$1
  [ -n "$word" ] || exit 0

  # Han anywhere means the Chinese side is being looked up, so gloss it into
  # English. A shell glob over the CJK range is not dependable across locales.
  if printf '%s' "$word" | grep -qP '\p{Han}'; then
    dir="zh:en"
  else
    dir="en:zh"
  fi

  # A lookup costs 0.4-1.4s, nearly all of it waiting on the translation
  # backend, so entries are kept forever -- a definition does not move.
  # Clear with: rm -rf "$CACHE"
  mkdir -p "$CACHE"
  hit="$CACHE/$(printf '%s:%s' "$dir" "$word" | sha256sum | cut -c1-32)"

  if [ -s "$hit" ]; then
    cat "$hit"
  else
    trans -d -no-ansi "$dir" -- "$word" 2>&1 | tee "$hit"
  fi
}

tui() {
  # --disabled hands the query to us instead of letting fzf filter, and the
  # leading sleep debounces: fzf kills the previous reload when the next
  # keystroke arrives, so only a pause actually spends a request.
  printf '' | fzf \
    --disabled \
    --layout=reverse \
    --prompt 'define  ' \
    --header 'type a word to translate between en/zh' \
    --bind "change:reload:sleep 0.3; $SELF --lookup {q} 2>/dev/null || true" \
    --bind 'enter:become(printf %s {} | wl-copy)' \
    --bind 'esc:abort'
}

case "${1-}" in
  --lookup) shift; lookup "${1-}" ;;
  --tui)
    for dep in fzf trans; do
      command -v $dep > /dev/null 2>&1 || { notify "missing dependency: $dep"; exit 1; }
    done
    tui
    ;;
  *)
    command -v "$TERMINAL" > /dev/null 2>&1 || { notify "missing terminal: $TERMINAL"; exit 1; }
    exec "$TERMINAL" --title=define --window-width=86 --window-height=28 -e "$SELF" --tui
    ;;
esac
