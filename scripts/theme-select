#!/bin/sh
#
# Pick a theme in fuzzel and apply it. The active one is marked and preselected,
# so the list opens on where you already are.

set -eu

SELF_DIR=$(dirname "$(readlink -f "$0")")
THEME="$SELF_DIR/theme"

notify() {
  command -v notify-send > /dev/null 2>&1 && notify-send -u critical theme "$1"
  echo "theme-select: $1" >&2
}

command -v fuzzel > /dev/null 2>&1 || {
  notify "missing dependency: fuzzel"
  exit 1
}

current=$("$THEME" current)

pick=$("$THEME" list \
  | sed "s/^$current\$/& ●/" \
  | fuzzel --dmenu --prompt 'theme  ' --lines 15 --width 30 \
      --select "$current ●") || exit 0

# strip the active marker back off before handing it to theme set
pick=${pick% ●}
[ -n "$pick" ] || exit 0
[ "$pick" = "$current" ] && exit 0

"$THEME" set "$pick" > /dev/null 2>&1
notify_msg="theme: $pick"
command -v notify-send > /dev/null 2>&1 && notify-send -t 2000 "$notify_msg"
echo "$notify_msg"
